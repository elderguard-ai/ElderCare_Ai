# Settings for `docker compose` (copy to .env in this folder). Never commit .env.

# This computer's Wi-Fi address, so phones can reach the API and open the hospital QR page
PUBLIC_BASE_URL=http://192.168.1.20:8000

# Database root password. Letters and digits only: it is placed inside the database URL.
MYSQL_ROOT_PASSWORD=elderguard-dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
